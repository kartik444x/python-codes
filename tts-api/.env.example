# ─────────────────────────────────────────────────────────────
# Production TTS API — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME="Production TTS API"
APP_ENV=development                  # development | staging | production
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=1                            # Uvicorn worker processes (set > 1 in production)
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                      # json | text (use text for local dev)

# ── TTS Model ─────────────────────────────────────────────────
TTS_MODEL=kokoro                     # kokoro (only supported engine in v1)
TTS_MODEL_VERSION=0.9.4              # Used in cache keys; bump when model changes
TTS_DEVICE=auto                      # auto | cpu | cuda
TTS_MODEL_DIR=./models               # Where to store downloaded model weights
MAX_TEXT_LENGTH=5000                 # Maximum characters per synchronous request
MAX_TEXT_LENGTH_ASYNC=50000          # Maximum characters for async jobs
MAX_CONCURRENT_SYNTHESIS=2          # Semaphore limit on simultaneous TTS calls
MODEL_WARMUP_ON_START=true           # Run a warmup inference at startup

# ── Audio ─────────────────────────────────────────────────────
AUDIO_SAMPLE_RATE=24000              # Kokoro native sample rate
AUDIO_DEFAULT_FORMAT=wav             # wav | mp3
AUDIO_RETENTION_HOURS=24             # Hours before generated audio is deleted
AUDIO_DIR=./generated_audio          # Local audio output directory

# ── Security ──────────────────────────────────────────────────
API_KEY_REQUIRED=true                # Set false only for local dev without auth
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING  # Used for key signing/hashing
# Add comma-separated API keys for simple single-key dev mode:
# DEV_API_KEYS=test-key-1,test-key-2
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100              # Requests per window
RATE_LIMIT_WINDOW=60                 # Window in seconds
RATE_LIMIT_STORAGE=memory            # memory | redis (redis for distributed)

# ── Database ──────────────────────────────────────────────────
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./tts_api.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tts_api
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=                      # Leave empty if no auth
REDIS_MAX_CONNECTIONS=10

# ── Caching ───────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL=3600                       # Seconds; 3600 = 1 hour
CACHE_BACKEND=redis                  # redis | memory | none

# ── Storage ───────────────────────────────────────────────────
STORAGE_BACKEND=local                # local | s3
# S3-compatible storage (leave empty for local):
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=                       # Optional CDN URL prefix

# ── Async Jobs (RQ) ───────────────────────────────────────────
JOB_QUEUE_NAME=tts-jobs
JOB_TIMEOUT=300                      # Max seconds a job can run
JOB_RESULT_TTL=86400                 # Seconds to keep job results in Redis
JOB_FAILURE_TTL=86400

# ── Observability ─────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PREFIX=tts_api

# ── Admin ─────────────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_THIS_ADMIN_KEY  # Key required for admin endpoints
